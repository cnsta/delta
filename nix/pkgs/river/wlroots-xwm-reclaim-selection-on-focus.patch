+void xwm_selection_reclaim(struct wlr_xwm *xwm) {
+	if (xwm->seat == NULL) {
+		return;
+	}
+
+	// X11 clients may only access the selection while an Xwayland surface is
+	// focused, but some (e.g. Wine) only fetch it once, when the owner
+	// changes. Re-assert ownership so they fetch it again now that access is
+	// allowed.
+	struct wlr_data_source *source = xwm->seat->selection_source;
+	if (source != NULL && !data_source_is_xwayland(source)) {
+		xwm_selection_set_owner(&xwm->clipboard_selection, true);
+	}
+
+	struct wlr_primary_selection_source *primary_source =
+		xwm->seat->primary_selection_source;
+	if (primary_source != NULL &&
+			!primary_selection_source_is_xwayland(primary_source)) {
+		xwm_selection_set_owner(&xwm->primary_selection, true);
+	}
+}
