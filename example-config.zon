// ~/.config/delta/config.zon
//
// Every field is optional. Anything omitted keeps its default. Unknown fields
// are an error rather than being ignored, so a typo tells you about itself.
.{
    // .bar = gap on output edges holding a bar (any exclusive layer); unset =
    // .edge. 0 suits a transparent bar.
    .gaps = .{ .between = 4, .edge = 4, .bar = 4 },

    .border = .{
        .width = 4,
        // .all (default) borders every edge. .between borders only tile edges
        // that face another tile or a bar, and drops the gap on the rest, so
        // a lone tile fills the screen. Floats keep every edge.
        .style = .all,
        .focused = 0x4c7a5d,
        .inactive = 0x504945,
    },

    .input = .{
        // Key repeat for every keyboard and for repeating bindings: delay in
        // ms, rate in repeats per second (0 = no repeat).
        .repeat_delay = 400,
        .repeat_rate = 40,
        // xkb keymap (.rules, .model, .layout, .variant, .options), applied
        // live on reload. Unset fields use libxkbcommon's defaults, including
        // XKB_DEFAULT_* from River's environment; set .variant along with
        // .layout, or the default variant is dropped. Leave the whole section
        // out and delta never touches the keymap. Unknown .options are
        // ignored silently by xkb, not reported. The first .devices entry
        // whose .name glob matches a keyboard's name (delta logs
        // `keyboard <name>` at startup) replaces the top-level names for it;
        // no match = top level.
        // .keyboard = .{
        //     .layout = "se",
        //     .variant = "nodeadkeys",
        //     .options = "ctrl:swapcaps",
        //     .devices = .{
        //         .{ .name = "*Ducky*", .layout = "us", .options = "ctrl:swapcaps" },
        //     },
        // },
        .focus_follows_pointer = true,
        .focus_new_windows = true,
        // focus_workspace on the workspace you're on goes back to the
        // previous one.
        .workspace_back_and_forth = false,
        // .none, .focus (keyboard focus moves) or .spawn (also new windows
        // launched from a keybinding, never children or click-opened ones).
        // Switching workspace never moves the pointer.
        // .theme sets the cursor River draws (over borders, the desktop)
        // and XCURSOR_THEME/XCURSOR_SIZE for programs delta spawns, e.g.
        // .cursor = .{ .warp = .focus, .theme = "Adwaita", .size = 24 },
        .cursor = .{ .warp = .focus },
        // Touchpads (devices that can tap). Unset fields keep libinput's
        // default. Also: .tap_button_map (.lrm/.lmr), .drag, .drag_lock
        // (.disabled/.timeout/.sticky), .three_finger_drag
        // (.disabled/.three_fingers/.four_fingers), .scroll_method
        // (.none/.two_finger/.edge), .clickfinger_button_map, .dwtp,
        // .middle_emulation, .left_handed, .send_events
        // (.enabled/.disabled/.disabled_on_external_mouse), .accel_profile
        // (.flat/.adaptive).
        // .touchpad = .{
        //     .tap = true,
        //     .natural_scroll = true,
        //     .dwt = true,
        //     .click_method = .clickfinger,
        //     .accel_speed = 0.2, // -1 to 1
        // },
        // Every other pointer (mice, trackballs, trackpoints).
        // .accel_profile: .flat/.adaptive/.custom. .custom takes a maccel
        // curve (github.com/Gnarus-G/maccel) in .accel_curve, same parameter
        // names and defaults: .mode = .linear (.accel, .offset, .output_cap),
        // .natural (.decay_rate, .offset, .limit) or .synchronous (.gamma,
        // .smooth, .motivity, .sync_speed); plus .sens_mult, .input_dpi
        // (leave at 1000 if hwdb sets MOUSE_DPI) and .max_speed (counts/ms
        // covered, default 64). No yx_ratio or angle_rotation.
        // .pointer = .{
        //     .accel_profile = .custom,
        //     .accel_curve = .{ .mode = .linear, .accel = 0.3, .offset = 2, .output_cap = 2 },
        // },
    },

    .layout = .{
        // A tile splits side by side when width > height * split_bias, else
        // stacked. Re-derived on every open/close/output change, except
        // splits set by toggle_split or an edge drop.
        .split_bias = 1.0,
        .resize_step = 32,
    },

    .animation = .{
        .enabled = true,
        .duration = 175,
        .fade_duration = 250,
        .curve = .ease_out,
    },

    // Runs when a reload fails, with the diagnostic as its last argument.
    .on_error = .{ "notify-send", "delta: config error" },

    // Omit this field entirely to keep the built-in bindings. An empty list
    // means you want none.
    .bindings = .{
        .{ .mods = .{.super}, .keys = .{"space"}, .action = .{ .spawn = .{"fuzzel"} } },
        .{ .mods = .{.super}, .keys = .{"t"}, .action = .{ .spawn = .{"ghostty"} } },
        .{ .mods = .{.super}, .keys = .{"w"}, .action = .{ .spawn = .{"zen"} } },

        .{ .mods = .{.super}, .keys = .{"q"}, .action = .close },
        .{ .mods = .{.super}, .keys = .{"f"}, .action = .toggle_fullscreen },
        .{ .mods = .{ .super, .shift }, .keys = .{"f"}, .action = .toggle_float },
        // The scratchpad is one global workspace drawn over the focused output:
        // super+Tab slides that output's windows away and the scratchpad's in
        // (an empty scratchpad shows the desktop). send_to_scratchpad on a
        // scratchpad window sends it back to the workspace it came from.
        // show_desktop is a deprecated alias of scratchpad.
        .{ .mods = .{.super}, .keys = .{"Tab"}, .action = .scratchpad },
        .{ .mods = .{ .super, .shift }, .keys = .{"s"}, .action = .send_to_scratchpad },

        // A dropdown: the first argument is an app_id glob, the rest the
        // command that starts it. Pressing it slides the app in over the
        // current workspace (floating, sized by its rule below), again hides
        // it; not running = spawn. Ghostty sets its app_id with --class, which
        // needs a dot: .{ "*.dropdown", "ghostty", "--class=dev.cnst.dropdown" }.
        .{ .mods = .{.super}, .keys = .{"d"}, .action = .{ .toggle_app = .{ "dropdown", "foot", "--app-id", "dropdown" } } },
        // Sticky: the (floating) window follows its output's workspace.
        .{ .mods = .{ .super, .shift }, .keys = .{"p"}, .action = .toggle_sticky },

        // Directional focus prefers the window you last focused that way, so
        // right-then-left returns where you were.
        .{ .mods = .{.super}, .keys = .{ "h", "Left" }, .action = .{ .focus_direction = .left } },
        .{ .mods = .{.super}, .keys = .{ "j", "Down" }, .action = .{ .focus_direction = .down } },
        .{ .mods = .{.super}, .keys = .{ "k", "Up" }, .action = .{ .focus_direction = .up } },
        .{ .mods = .{.super}, .keys = .{ "l", "Right" }, .action = .{ .focus_direction = .right } },

        // The following four binds only make sense on layouts where plus and minus aren't shifted keys.
        .{ .mods = .{.super}, .keys = .{ "plus", "KP_Add" }, .action = .{ .resize = .grow_width } },
        .{ .mods = .{.super}, .keys = .{ "minus", "KP_Subtract" }, .action = .{ .resize = .shrink_width } },

        .{ .mods = .{ .super, .shift }, .keys = .{ "plus", "KP_Add" }, .action = .{ .resize = .grow_height } },
        .{ .mods = .{ .super, .shift }, .keys = .{ "minus", "KP_Subtract" }, .action = .{ .resize = .shrink_height } },

        // The most recently focused other window, switching workspace to it.
        .{ .mods = .{.super}, .keys = .{"grave"}, .action = .focus_last },
        // Also .next/.prev (any workspace) and .focus_workspace_previous.
        .{ .mods = .{.super}, .keys = .{"bracketright"}, .action = .{ .cycle_workspace = .next_occupied } },
        .{ .mods = .{.super}, .keys = .{"bracketleft"}, .action = .{ .cycle_workspace = .prev_occupied } },

        .{ .mods = .{.super}, .keys = .{"1"}, .action = .{ .focus_workspace = 1 } },
        .{ .mods = .{.super}, .keys = .{"2"}, .action = .{ .focus_workspace = 2 } },
        .{ .mods = .{.super}, .keys = .{"3"}, .action = .{ .focus_workspace = 3 } },
        .{ .mods = .{.super}, .keys = .{"4"}, .action = .{ .focus_workspace = 4 } },
        .{ .mods = .{.super}, .keys = .{"5"}, .action = .{ .focus_workspace = 5 } },
        .{ .mods = .{.super}, .keys = .{"6"}, .action = .{ .focus_workspace = 6 } },
        .{ .mods = .{.super}, .keys = .{"7"}, .action = .{ .focus_workspace = 7 } },
        .{ .mods = .{.super}, .keys = .{"8"}, .action = .{ .focus_workspace = 8 } },
        .{ .mods = .{.super}, .keys = .{"9"}, .action = .{ .focus_workspace = 9 } },

        .{ .mods = .{ .super, .shift }, .keys = .{"1"}, .action = .{ .send_to_workspace = 1 } },
        .{ .mods = .{ .super, .shift }, .keys = .{"2"}, .action = .{ .send_to_workspace = 2 } },
        .{ .mods = .{ .super, .shift }, .keys = .{"3"}, .action = .{ .send_to_workspace = 3 } },
        .{ .mods = .{ .super, .shift }, .keys = .{"4"}, .action = .{ .send_to_workspace = 4 } },
        .{ .mods = .{ .super, .shift }, .keys = .{"5"}, .action = .{ .send_to_workspace = 5 } },
        .{ .mods = .{ .super, .shift }, .keys = .{"6"}, .action = .{ .send_to_workspace = 6 } },
        .{ .mods = .{ .super, .shift }, .keys = .{"7"}, .action = .{ .send_to_workspace = 7 } },
        .{ .mods = .{ .super, .shift }, .keys = .{"8"}, .action = .{ .send_to_workspace = 8 } },
        .{ .mods = .{ .super, .shift }, .keys = .{"9"}, .action = .{ .send_to_workspace = 9 } },

        .{ .mods = .{ .super, .shift }, .keys = .{"Delete"}, .action = .exit },
    },

    // Dragging a tile shows where it lands on the tile under the pointer:
    // near an edge it splits that tile on that side, in the middle the two
    // swap.
    .pointer_bindings = .{
        .{ .mods = .{.super}, .button = .left, .action = .pointer_move },
        .{ .mods = .{.super}, .button = .right, .action = .pointer_resize },
    },

    // Every matching rule applies, later ones winning per field. .matches:
    // any entry matching is enough (.app_id/.title globs, .dialog);
    // .excludes: none may match.
    .window_rules = .{
        .{ .matches = .{.{ .app_id = "vesktop" }}, .workspace = 4 },
        // The opening workspace of whatever output matches this name glob.
        .{ .matches = .{.{ .app_id = "obs" }}, .output = "HDMI-*" },
        // Floating geometry, used when the window first floats. Values <= 1
        // are fractions (of the work area for .size; of the free space for
        // .position, 0 = left/top, 0.5 = centred, 1 = right/bottom), larger
        // ones pixels. No .position = centred.
        .{
            .matches = .{.{ .app_id = "dropdown" }},
            .float = true,
            .size = .{ .width = 0.6, .height = 0.5 },
            .position = .{ .x = 0.5, .y = 0 },
        },
        .{ .matches = .{.{ .title = "Picture-in-Picture" }}, .float = true, .sticky = true, .size = .{ .width = 480, .height = 270 }, .position = .{ .x = 1, .y = 1 } },
        // Also: .border = false (no border, no inset), .scratchpad = true
        // (open in the scratchpad), .fullscreen, .focused, .warp.
        .{ .matches = .{.{ .app_id = "*", .dialog = true }}, .float = true },
    },
}
